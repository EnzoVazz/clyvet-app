{
  "expo": {
    "name": "clyvet-mobile",
    "slug": "clyvet-mobile",
    "version": "1.0.0",
    "scheme": "clyvet",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "br.com.fiap.clyvet",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-notifications",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#ffffff",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200
        }
      ]
    ],
    "extra": {
      "gitCommit": "bf1bfd80be8d9503a6f9dd3023b536bc4ac4598f",
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "2ce3ff62-a98b-4a46-bdbe-4c7428699b70"
      }
    }
  }
}
